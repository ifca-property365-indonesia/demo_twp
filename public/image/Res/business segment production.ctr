crosstab(columns="production_year, production_month" rows="description" values="sum(actual_qty for crosstab), sum(budget_qty for crosstab), sum(qty_variance for crosstab)" sourcenames = "production_year, production_month, production_code, budget_qty, budget_sum, actual_qty, actual_sum, no_of_guest, period, value_variance, qty_variance, quarter, period_qtr, description" crosstabonly=yes  band=foreground )
