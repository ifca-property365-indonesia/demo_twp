release 5;
datawindow(units=0 timer_interval=0 color=1073741824 processing=4 print.orientation=0 print.margin.left=110 print.margin.right=110 print.margin.top=97 print.margin.bottom=97 print.paper.size=0 print.paper.source=0 grid.lines=0 grid.columnmove=no selected.mouse=no crosstab.dynamic=yes)
header[1](height=65 )
header[2](height=65 )
header[3](height=65 )
header[4](height=65 )
summary(height=81 )
footer(height=0 )
detail(height=77 )
table(column=(type=char(20) updatewhereclause=yes name=description dbname="description"  )
column=(type=number updatewhereclause=yes name=actual_qty dbname="actual_qty"  )
column=(type=number updatewhereclause=yes name=budget_qty dbname="budget_qty"  )
column=(type=number updatewhereclause=yes name=qty_variance dbname="qty_variance"  )
 retrieve="  SELECT mgr.HS_PRODUCTION_STATISTICS.PRODUCTION_YEAR,   
         mgr.HS_PRODUCTION_STATISTICS.PRODUCTION_MONTH,   
         mgr.HS_PRODUCTION_STATISTICS.PRODUCTION_CODE,   
         mgr.HS_PRODUCTION_STATISTICS.BUDGET_QTY,   
         mgr.HS_PRODUCTION_STATISTICS.BUDGET_SUM,   
         mgr.HS_PRODUCTION_STATISTICS.ACTUAL_QTY,   
         mgr.HS_PRODUCTION_STATISTICS.ACTUAL_SUM,   
         mgr.HS_PRODUCTION_STATISTICS.NO_OF_GUEST,   
         convert(char(4), production_year) + '/' + substring(convert( char(3), 100 + production_month ), 2,2 ) period,   
         mgr.HS_PRODUCTION_STATISTICS.BUDGET_SUM - mgr.HS_PRODUCTION_STATISTICS.ACTUAL_SUM value_variance,   
         mgr.HS_PRODUCTION_STATISTICS.BUDGET_QTY - mgr.HS_PRODUCTION_STATISTICS.ACTUAL_QTY qty_variance,   
         CASE production_month 	when 1 then '1st Qtr' 
							when 2 then '1st Qtr' 
							when 3 then '1st Qtr' 
							when 4 then '2nd Qtr' 
							when 5 then '2nd Qtr' 
							when 6 then '2nd Qtr' 
							when 7 then '3rd Qtr' 
							when 8 then '3rd Qtr' 
							when 9 then '3rd Qtr' 
							when 10 then '4th Qtr' 
							when 11 then '4th Qtr' 
							when 12 then '4th Qtr' 
							end Quarter,   
         CASE production_month 	when 1 then convert(char(4),production_year) + ' 1st Qtr' 
							when 2 then convert(char(4),production_year) + ' 1st Qtr' 
							when 3 then convert(char(4),production_year) + ' 1st Qtr' 
							when 4 then convert(char(4),production_year) + ' 2nd Qtr' 
							when 5 then convert(char(4),production_year) + ' 2nd Qtr' 
							when 6 then convert(char(4),production_year) + ' 2nd Qtr' 
							when 7 then convert(char(4),production_year) + ' 3rd Qtr' 
							when 8 then convert(char(4),production_year) + ' 3rd Qtr' 
							when 9 then convert(char(4),production_year) + ' 3rd Qtr' 
							when 10 then convert(char(4),production_year) + ' 4th Qtr' 
							when 11 then convert(char(4),production_year) + ' 4th Qtr' 
							when 12 then convert(char(4),production_year) + ' 4th Qtr' end period_qtr,   
         CASE production_type 
							WHEN 1 THEN (select descs from mgr.hm_segment where segment_code = production_code) 
							WHEN 2 THEN (select descs from mgr.hm_source where source_code = production_code) 
							WHEN 3 THEN (select descs from mgr.hs_ratetype where rate_type = production_code) 
							WHEN 4 THEN (select distinct descs from mgr.hs_ratecode where rate_code = production_code) 
							WHEN 5 THEN (select descs from mgr.hm_roomtype where room_type = production_code) 
							WHEN 6 THEN (select convert(char(60),room_no) from mgr.hm_roommst where room_no = production_code) 
							WHEN 7 THEN (select name  from mgr.hs_channel where convert(char(8),channel_id) = 	production_code ) 
							WHEN 8 THEN (select name  from mgr.hs_ta where convert(char(8),ta_id) = production_code) 
							WHEN 9 THEN (select name  from mgr.hs_corp where convert(char(8),corp_id) = production_code) 
							WHEN 10 THEN (select descs from mgr.hm_country where country_code = production_code) 
							WHEN 11 THEN (select descs from mgr.hm_country where country_code = production_code) 
							WHEN 12 THEN (select descs from mgr.HM_TRXCD WHERE  trx_code = production_code  and  (mgr.HM_TRXCD.TYPE = 'B' or ( mgr.HM_TRXCD.TYPE = 'H' ) or ( mgr.HM_TRXCD.TYPE = 'M' ) or ( mgr.HM_TRXCD.TYPE = 'O') ))
							WHEN 13 THEN (select descs from mgr.hm_trxcd where trx_code = production_code and (type='P' or type='A' or type='C' or type='S' or type='D' or type='R' )) 
							end description  
    FROM mgr.HS_PRODUCTION_STATISTICS  
   WHERE ( mgr.HS_PRODUCTION_STATISTICS.PRODUCTION_TYPE = (:production_type_parm) ) AND  
         ( mgr.HS_PRODUCTION_STATISTICS.PRODUCTION_YEAR * 100 + mgr.HS_PRODUCTION_STATISTICS.PRODUCTION_MONTH in (:period_parm) ) AND  
         ( mgr.HS_PRODUCTION_STATISTICS.PRODUCTION_CODE in (:production_code_parm) )    

"
  arguments=(("production_type_parm", number), ("period_parm", numberlist), ("production_code_parm", stringlist))
 sort="description A"
)
