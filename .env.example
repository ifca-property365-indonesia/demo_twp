APP_NAME=TWP
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_STORAGE=storage
APP_URL=https://demo.property365.co.id:4421/demo_twp/
# alamat portal di email ke tenant (link login & logo); kosong = APP_URL
PORTAL_URL=https://demo.property365.co.id:4421/demo_twp/

LOG_CHANNEL=stack
# log per controller per hari: storage/logs/<yyyy-mm-dd>/<admin|tenant>/<controller>.log
LOG_STACK=controller

# Koneksi default: twp (SQL Server jbc_twp, lihat DB_DATABASE_TWP)
DB_CONNECTION=twp
# koneksi lama (MySQL demo_twp), tidak dipakai lagi
DB_HOST=
DB_PORT=1222
DB_DATABASE=jbc_twp
DB_USERNAME=
DB_PASSWORD=

# SQL Server jbc_live -> koneksi 'dblive' (tenant) dan 'ifcapb' (admin)
DB_HOST2=
DB_PORT2=1222
DB_DATABASE2=jbc_live
DB_USERNAME2=
DB_PASSWORD2=

# SQL Server jbc_twp (data portal TWP, schema mgr) -> koneksi 'twp' (default) dan 'ifcaadm' (admin).
# Host/port/login default sama dengan DB_*2; isi DB_HOST_TWP dst. kalau berbeda.
DB_DATABASE_TWP=jbc_twp
# ODBC Driver 18 menolak sertifikat self-signed; set false jika server SQL punya sertifikat valid
DB_TRUST_SERVER_CERTIFICATE2=true

# FTP file PDF proforma (disk 'ftp' di config/filesystems.php)
FTP_HOST=
FTP_PORT=21219
FTP_USERNAME=
FTP_PASSWORD=
FTP_ROOT=/CEM_TEST

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# nama cookie & path unik per aplikasi: beberapa aplikasi Laravel di host yang sama
# (mis. demo.property365.co.id:4421/...) dengan cookie bawaan saling menimpa session
# -> "CSRF token mismatch" / tiba-tiba logout.
# SESSION_PATH harus sama dengan path di APP_URL (lokal: /twp_demo, server: /demo_twp)
SESSION_COOKIE=twp_session
SESSION_PATH=/demo_twp

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@ifca.co.id
MAIL_FROM_NAME='IFCA SOFTWARE'

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY=
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
