APP_NAME=TWP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_STORAGE=storage
APP_URL=http://localhost/twp_demo/
# alamat portal di email ke tenant (link login & logo); kosong = APP_URL
PORTAL_URL=

LOG_CHANNEL=stack

# Koneksi default: twp (SQL Server jbc_twp, lihat DB_DATABASE_TWP)
DB_CONNECTION=twp
# MySQL demo_twp (lama, tidak dipakai lagi)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demo_twp
DB_USERNAME=
DB_PASSWORD=

# SQL Server jbc_live -> koneksi 'dblive' (tenant) dan 'ifcapb' (admin)
DB_HOST2=
DB_PORT2=1433
DB_DATABASE2=
DB_USERNAME2=
DB_PASSWORD2=

# SQL Server jbc_twp (data portal TWP, schema mgr) -> koneksi 'twp' (default) dan 'ifcaadm' (admin).
# Host/port/login default sama dengan DB_*2; isi DB_HOST_TWP dst. kalau berbeda.
DB_DATABASE_TWP=jbc_twp
# ODBC Driver 18 menolak sertifikat self-signed; set false jika server SQL punya sertifikat valid
DB_TRUST_SERVER_CERTIFICATE2=true

# FTP file PDF proforma (disk 'ftp' di config/filesystems.php)
FTP_HOST=
FTP_PORT=21
FTP_USERNAME=
FTP_PASSWORD=
FTP_ROOT=/

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# nama cookie & path unik per aplikasi: beberapa aplikasi Laravel di host yang sama
# (mis. demo.property365.co.id:4421/...) dengan cookie bawaan saling menimpa session
# -> "CSRF token mismatch" / tiba-tiba logout
SESSION_COOKIE=twp_session
SESSION_PATH=/twp_demo

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"
